    <groupId>com.newcron</groupId>
    <artifactId>global-dispatch</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>global-dispatch</name>
    <description>Proyecto Global Dispatch - NewCron</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- Para crear nuestra API REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

            <!-- Para convertir DispatchMessage a JSON -->
    <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
    </dependency>

            <!-- Solace Jakarta Messaging -->
    <dependency>
        <groupId>com.solacesystems</groupId>
        <artifactId>sol-jms-jakarta</artifactId>
        <version>10.30.0</version>
    </dependency>

       <!-- tus dependencias actuales -->

    <dependency>
        <groupId>com.fasterxml.jackson.datatype</groupId>
        <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
